<llm>

    <!-- 0.07m x 0.07m square sides, 0.3m length -->
    <!-- +x front robot, +y left robot -->
    <!-- beam1 is aligned with Y -->
    <body name="beam_1" pos="0.6 0.0 1.05" quat="0.707 0 0 0.707">
        <inertial mass="0.001" pos="0 0 0" fullinertia="0.00001 0.00001 0.00001 0 0 0" />
        <geom mesh="beam" class="obj" type="mesh"/>
        <geom mesh="beam" material="beam" class="visual" type="mesh"/>
        <freejoint/>
    </body>

    <!-- beam2 is aligned with Y -->
    <body name="beam_2" pos="0.8 0.15 1.05" quat="0.707 0 0 0.707">
        <inertial mass="0.001" pos="0 0 0" fullinertia="0.00001 0.00001 0.00001 0 0 0" />
        <geom mesh="beam" class="obj" type="mesh"/>
        <geom mesh="beam" material="beam" class="visual" type="mesh"/>
        <freejoint/>
    </body>

    <!-- beam3 is aligned with Z, rotated 45° around Z -->
    <body name="beam_3" pos="0.6 -0.3 1.20" quat="0.653 0.271 0.653 -0.271">
        <inertial mass="0.001" pos="0 0 0" fullinertia="0.00001 0.00001 0.00001 0 0 0" />
        <geom mesh="beam" class="obj" type="mesh"/>
        <geom mesh="beam" material="beam" class="visual" type="mesh"/>
        <freejoint/>
    </body>

</llm>