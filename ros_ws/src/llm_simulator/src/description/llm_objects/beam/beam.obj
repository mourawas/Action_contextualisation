# Beam OBJ file
# Updated dimensions: 0.5 x 0.06 x 0.06 (length x width x height)
# Square profile beam - elongated cube with square cross-section
# 6cm x 6cm square sides, 50cm length
# Fixed face winding order to prevent transparency issues

# Material library reference
mtllib beam.mtl
usemtl beam_material

# Vertices (8 corners of the box)
v -0.25 -0.03 -0.03
v  0.25 -0.03 -0.03
v  0.25  0.03 -0.03
v -0.25  0.03 -0.03
v -0.25 -0.03  0.03
v  0.25 -0.03  0.03
v  0.25  0.03  0.03
v -0.25  0.03  0.03

# Vertex normals (corrected directions)
vn  0.0  0.0 -1.0  # Bottom face normal
vn  0.0  0.0  1.0  # Top face normal
vn  0.0 -1.0  0.0  # Front face normal
vn  1.0  0.0  0.0  # Right face normal
vn  0.0  1.0  0.0  # Back face normal
vn -1.0  0.0  0.0  # Left face normal

# Faces (2 triangles per face, 12 triangles total)
# Fixed winding order - counter-clockwise when viewed from outside

# Bottom face (z = -0.015)
f 3//1 2//1 1//1
f 4//1 3//1 1//1

# Top face (z = 0.015)
f 5//2 6//2 7//2
f 5//2 7//2 8//2

# Front face (y = -0.03)
f 6//3 5//3 1//3
f 2//3 6//3 1//3

# Right face (x = 0.117188)
f 7//4 6//4 2//4
f 3//4 7//4 2//4

# Back face (y = 0.03)
f 8//5 7//5 3//5
f 4//5 8//5 3//5

# Left face (x = -0.117188)
f 5//6 8//6 4//6
f 1//6 5//6 4//6